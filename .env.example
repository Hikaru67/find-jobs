# Default: use the local Codex CLI authenticated with ChatGPT Plus.
AGENT_RUNTIME=codex

# Optional: use the original Agents SDK/API mode instead.
# AGENT_RUNTIME=api
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=gpt-6-astra

# Optional custom Codex executable path.
# CODEX_BIN=/Users/your-user/.local/bin/codex
